# Copy to .env for local development (api/worker on host).
# SailGuard dedicated ports (see docs/internal/ports.md):
#   API 18080 | Web 15180 | Postgres 15433 | Redis 16380

SG_HTTP_ADDR=127.0.0.1:18080
SG_DB_URL=postgres://sailguard:sailguard@127.0.0.1:15433/sailguard?sslmode=disable
SG_REDIS_URL=redis://127.0.0.1:16380/0
SG_JWT_SECRET=change-me-in-production-use-long-random-string
SG_ENV=development

# Prebuilt agents for admin "Download agent" installer packages (multi-channel)
# SG_AGENT_WIN7_PATH=bin/sailguard-agent-win7.exe          # windows-legacy (Go 1.20)
# SG_AGENT_WINDOWS_PATH=bin/sailguard-agent-windows.exe    # windows-current (Go current)
# SG_AGENT_SETUP_PATH=bin/sailguard-agent-setup.exe        # Windows setup (Go 1.20)
# Optional default server URL shown in the download form (LAN API base)
# SG_PUBLIC_AGENT_URL=http://172.31.254.26:18080

# Agent (on Windows host / VM) points at the API
# SG_SERVER_URL=http://127.0.0.1:18080
