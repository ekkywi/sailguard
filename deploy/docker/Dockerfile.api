# syntax=docker/dockerfile:1
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY pkgs ./pkgs
COPY services/controlplane ./services/controlplane
WORKDIR /src/services/controlplane
RUN CGO_ENABLED=0 go build -o /out/sailguard-api ./cmd/api

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/sailguard-api /usr/local/bin/sailguard-api
EXPOSE 8080
ENTRYPOINT ["sailguard-api"]
